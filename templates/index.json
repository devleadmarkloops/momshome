    "faq_hbtif7": {
      "type": "faq",
      "blocks": {
        "question_J7mNKq": {
          "type": "question",
          "settings": {
            "question": "How Long Does Delivery Take?",
            "answer": "<p>Orders are dispatched within 24 hours. Delivery takes 2-3 working days in Karachi, Lahore and Islamabad, and 3-5 working days elsewhere in Pakistan.</p>",
            "open": false
          }
        },
        "question_4BJaMP": {
          "type": "question",
          "settings": {
            "question": "Do You Deliver To My City?",
            "answer": "<p>Yes. We deliver to all major cities and towns across Pakistan through our courier partners. If your area is remote, our team will confirm delivery timing with you before dispatch.</p>",
            "open": false
          }
        },
        "question_kTaeNq": {
          "type": "question",
          "settings": {
            "question": "Do You Offer Cash On Delivery?",
            "answer": "<p>Yes. Cash on delivery is available across Pakistan. Pay the courier in cash when your parcel reaches your door, with no advance payment required.</p>",
            "open": false
          }
        },
        "question_eQKBre": {
          "type": "question",
          "settings": {
            "question": "Do You Accept Returns?",
            "answer": "<p>Yes. Items can be returned within XX days of delivery if they are unused and in their original packaging. Contact us to start a return.</p>",
            "open": false
          }
        },
        "question_m6ktih": {
          "type": "question",
          "settings": {
            "question": "What If My Item Arrives Damaged?",
            "answer": "<p>Send us a photo within 48 hours of delivery and we will arrange a free replacement. You do not pay return shipping on damaged items.</p>",
            "open": false
          }
        }
      },
