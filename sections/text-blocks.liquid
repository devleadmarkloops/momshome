{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="bp-contact color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="bp-contact__grid">
      <div class="bp-contact__col">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'left' -%}
            <div class="bp-contact__item" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="bp-contact__heading h3">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="bp-contact__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="bp-contact__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="bp-contact__col">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'right' -%}
            <div class="bp-contact__item" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="bp-contact__heading h3">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="bp-contact__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="bp-contact__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.bp-contact__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.6rem;
}

.bp-contact__col {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.bp-contact__heading {
  margin: 0 0 0.8rem;
  line-height: 1.3;
  color: rgb(var(--color-foreground));
}

.bp-contact__text {
  font-size: 1.6rem;
  line-height: 1.5;
  color: rgba(var(--color-foreground), 0.8);
}
.bp-contact__text p { margin: 0; }
.bp-contact__text p + p { margin-top: 0.8rem; }
.bp-contact__text a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 0.3rem;
}

.bp-contact__caption {
  margin: 0.6rem 0 0;
  font-size: 1.3rem;
  line-height: 1.4;
  color: rgba(var(--color-foreground), 0.5);
}

@media screen and (min-width: 750px) {
  .bp-contact__grid {
    grid-template-columns: 1fr 1fr;
    column-gap: 4rem;
    row-gap: 2.6rem;
  }
  .bp-contact__text {
    font-size: 1.8rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Text blocks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Info item",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add details here. You can include <a href=\"/\">links</a>.</p>"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (small, optional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Text blocks",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "column": "left",
            "heading": "Visit Here",
            "text": "<p>Falomo Square, 1 Alfred Rewane Rd, Ikoyi 106104, Lagos, Nigeria</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "column": "left",
            "heading": "Hours Of Operation",
            "text": "<p>Monday – Saturday: 10AM – 6PM (GMT)</p>",
            "caption": "We aim to respond to all enquiries within 24–48 business hours."
          }
        },
        {
          "type": "item",
          "settings": {
            "column": "right",
            "heading": "Other Enquiries",
            "text": "<p>For all other questions, please call <a href=\"tel:+2349168630776\">+234 916 863 0776</a> or message us on <a href=\"https://wa.me/2349168630776\">WhatsApp</a></p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "column": "right",
            "heading": "Returns & Exchanges",
            "text": "<p>We accept returns within a reasonable timeframe. Items must be unworn and in original condition. For return requests, email <a href=\"mailto:info@body-politix.com\">info@body-politix.com</a> with your order number.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
