{{ 'component-custom-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_align = section.settings.heading_alignment
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
-%}

<div class="custom-grid-section color-{{ section.settings.color_scheme }} gradient"
     style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <div class="custom-grid-header custom-grid-header--{{ heading_align }}">
        <h2 class="custom-grid-heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="custom-grid-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- paginate section.settings.collection.products by section.settings.products_per_page -%}

      <load-more-products
        class="load-more-products"
        data-grid-id="ProductGrid-{{ section.id }}"
        data-section-id="{{ section.id }}"
      >
        <div
          id="ProductGrid-{{ section.id }}"
          class="custom-grid"
          style="--grid-cols-mobile: {{ columns_mobile }}; --grid-cols-desktop: {{ columns_desktop }};"
        >
          {%- for product in section.settings.collection.products -%}
            {%- assign global_index = paginate.current_offset | plus: forloop.index -%}

            <div class="custom-grid__item custom-grid__item--product">
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                section_id: section.id
              -%}
            </div>

            {%- for block in section.blocks -%}
              {%- if block.type == 'text_card' and block.settings.insert_after == global_index -%}
                <div class="custom-grid__item custom-grid__item--text-card" {{ block.shopify_attributes }}>
                  <div class="text-card color-{{ block.settings.color_scheme }} text-card--{{ block.settings.text_alignment }}">
                    {%- if block.settings.eyebrow != blank -%}
                      <span class="text-card__eyebrow">{{ block.settings.eyebrow }}</span>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      <h3 class="text-card__heading">{{ block.settings.heading }}</h3>
                    {%- endif -%}
                    {%- if block.settings.subtext != blank -%}
                      <div class="text-card__subtext">{{ block.settings.subtext }}</div>
                    {%- endif -%}
                    {%- if block.settings.link_label != blank -%}
                      <a href="{{ block.settings.link_url | default: '#' }}" class="text-card__link">
                        {{ block.settings.link_label }}
                        <span aria-hidden="true">&rarr;</span>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="custom-grid__empty">
              <p>{{ 'sections.collection_template.empty' | t | default: 'No products found in this collection.' }}</p>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.enable_load_more and paginate.next -%}
          <div class="load-more-wrapper" data-load-more-id="{{ section.id }}">
            <button
              type="button"
              class="button {{ section.settings.load_more_button_style }} load-more-button"
              data-load-more-button
              data-next-url="{{ paginate.next.url }}"
            >
              <span class="load-more-button__label">
                {{ section.settings.load_more_button_label | default: 'Load more' }}
              </span>
              <span class="load-more-button__spinner">
                {%- render 'loading-spinner' -%}
              </span>
            </button>
          </div>
        {%- endif -%}
      </load-more-products>

    {%- endpaginate -%}

  </div>
</div>

<script src="{{ 'load-more-products.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Custom product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Wanted"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "header",
      "content": "Load more button"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Enable load more button",
      "default": true
    },
    {
      "type": "text",
      "id": "load_more_button_label",
      "label": "Button label",
      "default": "Load more"
    },
    {
      "type": "select",
      "id": "load_more_button_style",
      "label": "Button style",
      "options": [
        { "value": "button--primary", "label": "Solid" },
        { "value": "button--secondary", "label": "Outline" }
      ],
      "default": "button--secondary"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text_card",
      "name": "Text card",
      "settings": [
        {
          "type": "paragraph",
          "content": "This card is inserted into the product grid after the product count you set below."
        },
        {
          "type": "number",
          "id": "insert_after",
          "label": "Show after how many product cards",
          "default": 1,
          "info": "e.g. 4 shows the card right after the 4th product."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "STYLED BY US"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Three ways to wear it"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Text",
          "default": "<p>One piece. Every occasion.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read the edit"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "left"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom product grid",
      "blocks": [
        { "type": "text_card" }
      ]
    }
  ]
}
{% endschema %}
