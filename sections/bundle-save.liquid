<style>

.bundle-save-wrapper {
  padding-top: var(--bundle-save-padding-top, 60px);
  padding-bottom: var(--bundle-save-padding-bottom, 60px);
}

.bundle-save-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  align-items: center;
  gap: 4rem;
}

.bundle-save-grid--left {
  grid-template-areas: 'content media';
}

.bundle-save-grid--left .bundle-save-grid__content {
  grid-area: content;
}

.bundle-save-grid--left .bundle-save-grid__media {
  grid-area: media;
}

.bundle-save-grid--right {
  grid-template-areas: 'media content';
}

.bundle-save-grid--right .bundle-save-grid__media {
  grid-area: media;
}

.bundle-save-grid--right .bundle-save-grid__content {
  grid-area: content;
}

@media screen and (max-width: 989px) {
  .bundle-save-grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .bundle-save-grid--left,
  .bundle-save-grid--right {
    grid-template-areas:
      'media'
      'content';
  }
}

.bundle-save-grid__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.2rem;
}

.bundle-save-grid__eyebrow {
  margin: 0;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size:10px;
}

.bundle-save-grid__heading {
  margin: 0;
  text-transform: unset;
  max-width: 450px;
}

.bundle-save-grid__text {
  margin: 0;
}
span.save-amount {
    opacity: 1 !important;
    font-weight: 600;
}
.bundle-save-grid__price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 0.5rem;
  row-gap: 0;
}

.bundle-save-grid__price-compare {
    opacity: 0.55;
    width: 100%;
    line-height: 1;
}

.bundle-save-grid__price-current {
    margin: 0;
    letter-spacing: 0;
    font-size: 36px;
}

.bundle-save-grid__price-savings {
  opacity: 0.7;
}

.bundle-save-grid__buttons {
  margin-top: 0.5rem;
}

.bundle-save-grid__media {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.bundle-save-grid__image img,
.bundle-save-grid__image svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #fff;
  max-height: 500px;
}

.bundle-save-grid__plus {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 5rem;
  height: 5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  color: #fff;
}

.bundle-save-grid__plus svg {
    width: 19px;
    height: 19px;
}

@media screen and (max-width:749px){
.bundle-save-grid__media {
    gap: 12px;
}
.bundle-save-grid__plus {
    width: 4rem;
    height: 4rem;
}
.bundle-save-grid__plus svg {
    width: 15px;
    height: 15px;
}
.bundle-save-grid__content {
    gap: 8px;
}
.bundle-save-grid__price-current {
    font-size: 22px;
}
}

</style>

{%- liquid
  assign position = section.settings.content_position
-%}

{% style %}
  .bundle-save-section-{{ section.id }} .bundle-save-wrapper {
    --bundle-save-padding-top: {{ section.settings.padding_top_mobile }}px;
    --bundle-save-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .bundle-save-section-{{ section.id }} .bundle-save-wrapper {
      --bundle-save-padding-top: {{ section.settings.padding_top }}px;
      --bundle-save-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }} gradient bundle-save-section-{{ section.id }}">
  <div class="bundle-save-wrapper{% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="bundle-save-grid bundle-save-grid--{{ position }}">

      <div class="bundle-save-grid__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <p class="bundle-save-grid__eyebrow" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </p>

            {%- when 'heading' -%}
              <h2
                class="bundle-save-grid__heading {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h2>

            {%- when 'text' -%}
              <div class="bundle-save-grid__text rte typeset1" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'price' -%}
              {%- liquid
                if section.settings.product_1 != blank and section.settings.product_2 != blank
                  assign variant_1 = section.settings.product_1.selected_or_first_available_variant
                  assign variant_2 = section.settings.product_2.selected_or_first_available_variant
                  assign price = variant_1.price | plus: variant_2.price
                  assign compare_1 = variant_1.compare_at_price | default: variant_1.price
                  assign compare_2 = variant_2.compare_at_price | default: variant_2.price
                  assign compare_price = compare_1 | plus: compare_2
                  assign is_bundle_pricing = true
                else
                  assign linked_product = block.settings.product
                  if linked_product != blank
                    assign price = linked_product.price
                    assign compare_price = linked_product.compare_at_price
                  else
                    assign price = block.settings.manual_price
                    assign compare_price = block.settings.manual_compare_price
                  endif
                  assign is_bundle_pricing = false
                endif

                assign show_compare = false
                if compare_price != blank and compare_price > price
                  assign show_compare = true
                  assign savings = compare_price | minus: price
                endif
              -%}
              <div class="bundle-save-grid__price" {{ block.shopify_attributes }}>
                {%- if show_compare -%}
                  <s class="bundle-save-grid__price-compare typeset0">
                    {%- if is_bundle_pricing or linked_product != blank -%}
                      {{ compare_price | money }}
                    {%- else -%}
                      {{ compare_price | times: 100 | money }}
                    {%- endif -%}
                  </s>
                {%- endif -%}
                <span class="bundle-save-grid__price-current h2">
                  {%- if is_bundle_pricing or linked_product != blank -%}
                    {{ price | money }}
                  {%- else -%}
                    {{ price | times: 100 | money }}
                  {%- endif -%}
                </span>
                {%- if show_compare -%}
                  <span class="bundle-save-grid__price-savings typeset0">
                You save
                <span class="save-amount">
                    {% if is_bundle_pricing or linked_product != blank %}
                    {{ savings | money }}
                    {% else %}
                    {{ savings | times: 100 | money }}
                    {% endif %}
                </span>
                </span>
                {%- endif -%}
              </div>

            {%- when 'button' -%}
              <div class="bundle-save-grid__buttons" {{ block.shopify_attributes }}>
                {%- if section.settings.product_1 != blank and section.settings.product_2 != blank -%}
                  {%- liquid
                    assign variant_1 = section.settings.product_1.selected_or_first_available_variant
                    assign variant_2 = section.settings.product_2.selected_or_first_available_variant
                  -%}
                  <button
                    type="button"
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} bundle-save-add-btn"
                    data-bundle-add-btn
                    data-variant-1="{{ variant_1.id }}"
                    data-variant-2="{{ variant_2.id }}"
                    {% unless variant_1.available and variant_2.available %}disabled{% endunless %}
                  >
                    <span data-btn-text>
                      {%- if variant_1.available and variant_2.available -%}
                        {{ block.settings.button_label | default: 'Add Bundle to Cart' }}
                      {%- else -%}
                        Sold out
                      {%- endif -%}
                    </span>
                  </button>
                {%- elsif block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- liquid
        assign bundle_product_1 = section.settings.product_1
        assign bundle_product_2 = section.settings.product_2

        if bundle_product_1 != blank
          assign image_1_final = bundle_product_1.featured_image
        else
          assign image_1_final = section.settings.image_1
        endif

        if bundle_product_2 != blank
          assign image_2_final = bundle_product_2.featured_image
        else
          assign image_2_final = section.settings.image_2
        endif
      -%}

      <div class="bundle-save-grid__media">
        <div class="bundle-save-grid__image bundle-save-grid__image--1">
          {%- if image_1_final != blank -%}
            {{
              image_1_final
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1200'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="bundle-save-grid__image bundle-save-grid__image--2">
          {%- if image_2_final != blank -%}
            {{
              image_2_final
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1200'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.show_plus_icon -%}
          <div class="bundle-save-grid__plus color-{{ section.settings.plus_icon_color_scheme }}" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<script>
  (function () {
    var btn = document.querySelector('#shopify-section-{{ section.id }} [data-bundle-add-btn]');
    if (!btn) return;

    btn.addEventListener('click', function () {
      var variant1 = btn.getAttribute('data-variant-1');
      var variant2 = btn.getAttribute('data-variant-2');
      var textEl = btn.querySelector('[data-btn-text]');
      var originalText = textEl.textContent;
      var cartDrawer = document.querySelector('cart-drawer');

      textEl.textContent = 'Adding...';
      btn.disabled = true;

      // Step 1: add first item (plain add, no sections needed yet)
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variant1, quantity: 1 })
      })
        .then(function (response) {
          if (!response.ok) throw new Error('Add to cart failed (item 1)');
          return response.json();
        })
        .then(function () {
          // Step 2: add second item, and request the sections Dawn's cart-drawer needs
          var body = { id: variant2, quantity: 1 };

          if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
            body.sections = cartDrawer.getSectionsToRender().map(function (s) { return s.id; });
            body.sections_url = window.location.pathname;
          }

          return fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body)
          });
        })
        .then(function (response) {
          if (!response.ok) throw new Error('Add to cart failed (item 2)');
          return response.json();
        })
        .then(function (data) {
          textEl.textContent = 'Added!';

          if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
            cartDrawer.classList.remove('is-empty');
            cartDrawer.renderContents(data);
          } else {
            window.location = window.Shopify.routes.root + 'cart';
            return;
          }

          setTimeout(function () {
            textEl.textContent = originalText;
            btn.disabled = false;
          }, 1500);
        })
        .catch(function (err) {
          console.error(err);
          textEl.textContent = 'Error - try again';
          setTimeout(function () {
            textEl.textContent = originalText;
            btn.disabled = false;
          }, 1500);
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Bundle & save",
  "tag": "section",
  "class": "section bundle-save-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "info": "On mobile, this also controls whether the images appear above or below the content.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Bundle products (optional)"
    },
    {
      "type": "paragraph",
      "content": "If you select products here, their images, prices, and 'Add to cart' button will be used automatically instead of the manual image/price settings below."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "checkbox",
      "id": "show_plus_icon",
      "label": "Show plus icon between images",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "plus_icon_color_scheme",
      "label": "Plus icon color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Bundle & Save"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Buy any 2 dresses, save 15%."
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Mix and match across the entire collection. Discount applied automatically at checkout — no code needed.</p>"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Link a product for live pricing",
          "info": "If selected, price and compare-at price pull live from this product. Leave blank to enter prices manually below."
        },
        {
          "type": "header",
          "content": "Manual pricing (used if no product is linked)"
        },
        {
          "type": "number",
          "id": "manual_price",
          "label": "Price",
          "default": 200
        },
        {
          "type": "number",
          "id": "manual_compare_price",
          "label": "Compare-at price",
          "default": 236
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build Your Bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use outline button style",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle & save",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "price" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
