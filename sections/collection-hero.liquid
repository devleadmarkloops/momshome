<style>

.collection-hero-section {
  overflow: hidden;
}

.collection-hero-wrapper {
  padding-top: var(--collection-hero-padding-top, 36px);
  padding-bottom: var(--collection-hero-padding-bottom, 36px);
}

.collection-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
}

.collection-hero-grid--left {
  grid-template-areas: 'media content';
}

.collection-hero-grid--left .collection-hero-grid__media {
  grid-area: media;
}

.collection-hero-grid--left .collection-hero-grid__content {
  grid-area: content;
}

.collection-hero-grid--right {
  grid-template-areas: 'content media';
}

.collection-hero-grid--right .collection-hero-grid__content {
  grid-area: content;
}
.collection-hero-section--full-width .collection-hero-grid--right .collection-hero-grid__image,
.collection-hero-section--full-width .collection-hero-grid--right .collection-hero-grid__image--placeholder {
  width: calc(100% + (100vw - 100%) / 2);
}

.collection-hero-section--full-width .collection-hero-grid--left .collection-hero-grid__image,
.collection-hero-section--full-width .collection-hero-grid--left .collection-hero-grid__image--placeholder {
  width: calc(100% + (100vw - 100%) / 2);
  margin-left: calc(-1 * (100vw - 100%) / 2);
}
.collection-hero-grid--right .collection-hero-grid__media {
  grid-area: media;
}

.collection-hero-grid__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.5rem;
}

.collection-hero-grid__heading {
  margin: 0;
}

.collection-hero-grid__text {
  margin: 0;
  max-width: 405px;
}

.collection-hero-grid__buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.collection-hero-grid__checkmark {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 12px;
}

.collection-hero-grid__checkmark-icon svg {
  width: 1rem;
  height: 1rem;
}

.collection-hero-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-weight: 300;
}

.collection-hero-breadcrumbs a {
  text-decoration: none;
  color: inherit;
  text-transform: uppercase;
}

.collection-hero-breadcrumbs__current {
  text-transform: uppercase;
}

.collection-hero-grid__media {
  position: relative;
  width: 100%;
}

.collection-hero-grid__image,
.collection-hero-grid__image--placeholder {
  display: block;
  width: 100%;
  height: var(--collection-hero-image-height, auto);
  object-fit: cover;
}

.collection-hero-badge {
  position: absolute;
  left: 2rem;
  bottom: 2rem;
  padding: 1.6rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.button_checks_parent {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 12px;
}
.collection-hero-badge__stars svg {
  width: 9rem;
  height: auto;
}

.collection-hero-badge__number {
  font-size: 30px;
  font-weight: 700;
  margin: 0;
}

.collection-hero-badge__label {
  margin: 0;
  font-size: 10px;
  opacity: 0.75;
  text-transform: uppercase;
  letter-spacing: 2px;
}
@media screen and (max-width: 749px) {
  .collection-hero-grid__image,
  .collection-hero-grid__image--placeholder {
    height: var(--collection-hero-image-height-mobile, auto);
  }
  .collection-hero-wrapper {
    padding-top: var(--collection-hero-padding-top-mobile, 28px);
    padding-bottom: var(--collection-hero-padding-bottom-mobile, 28px);
  }
  .collection-hero-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .collection-hero-grid--left,
  .collection-hero-grid--right {
    grid-template-areas:
      'media'
      'content';
  }
  .collection-hero-badge {
    left: 0rem;
    bottom: 1rem;
    padding: 1.2rem 1.5rem;
  }
  .collection-hero-badge__number {
    font-size: 20px;
  }

  .collection-hero-badge__label {
    letter-spacing: 1px;
  }
.collection-hero-section--full-width .collection-hero-grid__image,
  .collection-hero-section--full-width .collection-hero-grid__image--placeholder {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .collection-hero-section--full-width .collection-hero-grid--right .collection-hero-grid__image, .collection-hero-section--full-width .collection-hero-grid--right .collection-hero-grid__image--placeholder {
    width: calc(100% + (100vw - 100%) / 1);
}
  .collection-hero-grid__content {
    gap: 10px;
  }
  .button_checks_parent {
    gap: 7px;
    margin-top: 5px;
  }
}




</style>

{%- liquid
  assign image_position = section.settings.image_position
-%}

{% style %}
  .collection-hero-section-{{ section.id }} .collection-hero-wrapper {
    --collection-hero-padding-top: {{ section.settings.padding_top }}px;
    --collection-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --collection-hero-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --collection-hero-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }
  .collection-hero-section-{{ section.id }} .collection-hero-grid__image {
    --collection-hero-image-height: {% if section.settings.image_height != 0 %}{{ section.settings.image_height }}px{% else %}auto{% endif %};
  }
  @media screen and (max-width: 749px) {
    .collection-hero-section-{{ section.id }} .collection-hero-grid__image {
      --collection-hero-image-height-mobile: {% if section.settings.image_height_mobile != 0 %}{{ section.settings.image_height_mobile }}px{% else %}auto{% endif %};
    }
  }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }} gradient collection-hero-section-{{ section.id }}">
 <div class="collection-hero-wrapper page-width{% if section.settings.full_width %} collection-hero-section--full-width{% endif %}">
    <div class="collection-hero-grid collection-hero-grid--{{ image_position }}">

      <div class="collection-hero-grid__content">

        {%- if section.settings.show_breadcrumbs -%}
          <nav class="collection-hero-breadcrumbs typeset0" aria-label="breadcrumbs">
            <a href="{{ routes.root_url }}">Home</a>
            <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="5" height="10" viewBox="0 0 5 10" fill="none">
              <path d="M0.500015 0.500015L3.83335 4.66668L0.500015 8.83335" stroke="#141511" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              </span>
            <a href="{{ routes.all_products_collection_url }}">Collection</a>
            {%- if collection -%}
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="5" height="10" viewBox="0 0 5 10" fill="none">
                <path d="M0.500015 0.500015L3.83335 4.66668L0.500015 8.83335" stroke="#141511" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="collection-hero-breadcrumbs__current">{{ collection.title }}</span>
            {%- endif -%}
          </nav>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              <h2
                class="collection-hero-grid__heading {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h2>

            {%- when 'text' -%}
              <div class="collection-hero-grid__text rte typeset" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'button' -%}
              <div class="collection-hero-grid__button-group" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <div class="collection-hero-grid__buttons">
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                    >
                      {{ block.settings.button_label }}
                    </a>
                  </div>
                {%- endif -%}
                  <div class="button_checks_parent">
                {%- for i in (1..3) -%}
                  {%- assign checkmark_text = 'checkmark_' | append: i | append: '_text' -%}
                  {%- assign checkmark_value = block.settings[checkmark_text] -%}
                  {%- if checkmark_value != blank -%}
                    <div class="collection-hero-grid__checkmark">
                      <span class="collection-hero-grid__checkmark-icon" aria-hidden="true">
                       <svg viewBox="0 0 17 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon icon-checkmark" aria-hidden="true" focusable="false">
                        <path d="M1 6.5L6 11.5L16 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>

                      </span>
                      <span>{{ checkmark_value }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}

      </div>

      <div class="collection-hero-grid__media">
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              class: 'collection-hero-grid__image',
              widths: '375, 550, 750, 1100, 1500'
          }}
        {%- else -%}
          <div class="collection-hero-grid__image collection-hero-grid__image--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_rating_badge -%}
          <div class="collection-hero-badge color-{{ section.settings.badge_color_scheme }}">
            {%- if section.settings.show_stars -%}
              <span class="collection-hero-badge__stars" aria-hidden="true">
                <svg viewBox="0 0 130 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon icon-star-rating" aria-hidden="true" focusable="false">
                  {%- for i in (0..4) -%}
                    {%- assign x_offset = i | times: 26 -%}
                    <path
                      transform="translate({{ x_offset }}, 0)"
                      d="M12 1.5L14.9 8.7L22.5 9.3L16.7 14.3L18.5 21.8L12 17.7L5.5 21.8L7.3 14.3L1.5 9.3L9.1 8.7L12 1.5Z"
                      fill="currentColor"
                    />
                  {%- endfor -%}
                </svg>

              </span>
            {%- endif -%}
            <p class="collection-hero-badge__number">{{ section.settings.badge_number }}</p>
            <p class="collection-hero-badge__label">{{ section.settings.badge_label }}</p>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section collection-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "On mobile, this also controls whether the image appears above or below the content.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Image height (desktop)",
      "info": "Set to 0 for auto height",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Image height (mobile)",
      "info": "Set to 0 for auto height",
      "default": 0
    },
    {
      "type": "header",
      "content": "Rating badge"
    },
    {
      "type": "checkbox",
      "id": "show_rating_badge",
      "label": "Show rating badge",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "badge_color_scheme",
      "label": "Badge color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "badge_number",
      "label": "Badge number",
      "default": "2,400+"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star icons",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "5-Star Reviews"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Dress Edit"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h0"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Occasion-ready silhouettes cut for real curves. 48 styles in sizes XS-4X, restocked weekly.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Best Sellers"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use outline button style",
          "default": true
        },
        {
          "type": "header",
          "content": "Checkmarks (shown below the button)"
        },
        {
          "type": "text",
          "id": "checkmark_1_text",
          "label": "Checkmark 1",
          "default": "Free shipping $150+"
        },
        {
          "type": "text",
          "id": "checkmark_2_text",
          "label": "Checkmark 2",
          "default": "XS-4X sizing"
        },
        {
          "type": "text",
          "id": "checkmark_3_text",
          "label": "Checkmark 3",
          "default": "Free 30-day returns"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}

