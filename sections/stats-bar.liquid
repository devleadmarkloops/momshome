<style>

.stats-bar {
  border-top: 1px solid rgba(var(--color-foreground), 0.15);
}

.stats-bar__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.stats-bar__item {
  flex: 1 1 0;
  min-width: 22rem;
  text-align: center;
  padding: 2rem 3rem;
  border-left: 1px solid rgb(0 0 0 / 30%);
}

.stats-bar__item:first-child {
  border-left: none;
}

.stats-bar__heading {
  margin: 0 0 0.5rem 0;
}

.stats-bar__text {
  margin: 0;
  color: rgba(var(--color-foreground), 0.75);
  letter-spacing: 2px;
}

@media screen and (max-width: 749px) {
  .stats-bar__item {
    flex: 1 1 100%;
    min-width: 0;
    border-left: none;
    border-top: 1px solid rgba(var(--color-foreground), 0.15);
    padding: 1.8rem 0rem;
  }

  .stats-bar__item:first-child {
    border-top: none;
  }
}

</style>

<div class="stats-bar color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="stats-bar__grid stats-bar__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="stats-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="stats-bar__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="stats-bar__text caption-with-letter-spacing typeset0">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Stats bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "XS-4X"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h5", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h4", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h3", "label": "t:sections.all.heading_size.options__3.label" },
            { "value": "h2", "label": "t:sections.all.heading_size.options__4.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__5.label" }
          ],
          "default": "h3"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Supporting text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Stats bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "heading": "XS-4X",
            "text": "All silhouettes, every size"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "2,400+",
            "text": "Verified 5-star reviews"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "Free",
            "text": "Returns within 30 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
