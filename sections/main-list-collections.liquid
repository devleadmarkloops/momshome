{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign initial = section.settings.collections_to_show

  case section.settings.sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif

  case section.settings.image_ratio
    when 'square'
      assign ratio_css = '1 / 1'
    when 'portrait'
      assign ratio_css = '3 / 4'
    else
      assign ratio_css = ''
  endcase
-%}

{%- style -%}
  .dc-collections-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .dc-collections-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .dc-collections-{{ section.id }} .dc-title {
    text-align: {{ section.settings.heading_alignment_mobile }};
    margin: 0 0 2.6rem;
  }
  @media screen and (min-width: 750px) {
    .dc-collections-{{ section.id }} .dc-title {
      text-align: {{ section.settings.heading_alignment_desktop }};
      margin: 0 0 3.5rem;
    }
  }

  .dc-collections-{{ section.id }} .dc-grid {
    display: grid;
    grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr));
    gap: 2.8rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media screen and (min-width: 750px) {
    .dc-collections-{{ section.id }} .dc-grid {
      grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
      gap: 4.5rem 2rem;
    }
  }

  .dc-collections-{{ section.id }} .dc-item--hidden { display: none !important; }

  .dc-collections-{{ section.id }} .dc-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .dc-collections-{{ section.id }} .dc-card__media {
    display: block;
    overflow: hidden;
    background-color: #f5f2ec;
    {% if ratio_css != blank %}aspect-ratio: {{ ratio_css }};{% endif %}
  }
  .dc-collections-{{ section.id }} .dc-card__media img,
  .dc-collections-{{ section.id }} .dc-card__media svg {
    display: block;
    width: 100%;
    {% if ratio_css != blank %}height: 100%;{% else %}height: auto;{% endif %}
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .dc-collections-{{ section.id }} .dc-card:hover .dc-card__media img {
    transform: scale(1.04);
  }

  .dc-collections-{{ section.id }} .dc-card__info {
    text-align: {{ section.settings.card_alignment }};
    padding-top: 1.4rem;
  }
  .dc-collections-{{ section.id }} .dc-card__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02rem;
  }
  .dc-collections-{{ section.id }} .dc-card__count {
    margin: 0.3rem 0 0;
    font-size: 1.3rem;
    line-height: 1.4;
    opacity: 0.6;
  }

  .dc-collections-{{ section.id }} .dc-loadmore-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }
  @media screen and (min-width: 750px) {
    .dc-collections-{{ section.id }} .dc-loadmore-wrap { margin-top: 5rem; }
  }
  .dc-collections-{{ section.id }} .dc-loadmore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18rem;
    padding: 1.5rem 4rem;
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 0;
    cursor: pointer;
    font-size: 1.2rem;
    letter-spacing: 0;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }
  .dc-collections-{{ section.id }} .dc-loadmore:hover { opacity: 0.85; }
{%- endstyle -%}

<div class="dc-collections-{{ section.id }} page-width">
  {%- if section.settings.title != blank -%}
    <h1 class="dc-title title title--primary inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ section.settings.title }}
    </h1>
  {%- endif -%}

  <ul class="dc-grid" id="dc-grid-{{ section.id }}" role="list">
    {%- for collection in collections -%}
      {%- liquid
        assign card_image = collection.featured_image
        if card_image == blank
          assign card_image = collection.products.first.featured_image
        endif
        assign is_hidden = false
        if forloop.index0 >= initial
          assign is_hidden = true
        endif
      -%}
      <li class="dc-item{% if is_hidden %} dc-item--hidden{% endif %}" data-dc-item>
        <a href="{{ collection.url }}" class="dc-card">
          <div class="dc-card__media">
            {%- if card_image != blank -%}
              <img
                srcset="
                  {%- if card_image.width >= 275 -%}{{ card_image | image_url: width: 275 }} 275w,{%- endif -%}
                  {%- if card_image.width >= 550 -%}{{ card_image | image_url: width: 550 }} 550w,{%- endif -%}
                  {%- if card_image.width >= 750 -%}{{ card_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if card_image.width >= 1100 -%}{{ card_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                  {%- if card_image.width >= 1500 -%}{{ card_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                  {{ card_image | image_url }} {{ card_image.width }}w
                "
                src="{{ card_image | image_url: width: 550 }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns_desktop }}px, (min-width: 750px) calc((100vw - 10rem) / {{ columns_desktop }}), calc((100vw - 3rem) / {{ columns_mobile }})"
                alt="{{ card_image.alt | escape }}"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'dc-card__placeholder' }}
            {%- endif -%}
          </div>
          <div class="dc-card__info">
            <h3 class="dc-card__title">{{ collection.title | escape }}</h3>
            <p class="dc-card__count">{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}Product{% else %}Products{% endif %}</p>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {%- if collections.size > initial -%}
    <div class="dc-loadmore-wrap">
      <button type="button" class="dc-loadmore" data-load-more data-batch="{{ initial }}">
        {{ section.settings.load_more_label | default: 'Load More' }}
      </button>
    </div>
  {%- endif -%}
</div>

<noscript>
  <style>#dc-grid-{{ section.id }} .dc-item--hidden { display: block !important; }</style>
</noscript>

<script>
  (function () {
    var grid = document.getElementById('dc-grid-{{ section.id }}');
    if (!grid) return;
    var wrapper = grid.closest('.dc-collections-{{ section.id }}');
    var btn = wrapper ? wrapper.querySelector('[data-load-more]') : null;
    if (!btn) return;

    var items = grid.querySelectorAll('[data-dc-item]');
    var batch = parseInt(btn.getAttribute('data-batch'), 10) || 8;
    var visible = batch;

    btn.addEventListener('click', function () {
      visible += batch;
      for (var i = 0; i < items.length; i++) {
        if (i < visible) items[i].classList.remove('dc-item--hidden');
      }
      if (visible >= items.length) btn.style.display = 'none';
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "t:sections.main-list-collections.settings.title.default"
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        { "value": "alphabetical", "label": "t:sections.main-list-collections.settings.sort.options__1.label" },
        { "value": "alphabetical_reversed", "label": "t:sections.main-list-collections.settings.sort.options__2.label" },
        { "value": "date_reversed", "label": "t:sections.main-list-collections.settings.sort.options__3.label" },
        { "value": "date", "label": "t:sections.main-list-collections.settings.sort.options__4.label" },
        { "value": "products_high", "label": "t:sections.main-list-collections.settings.sort.options__5.label" },
        { "value": "products_low", "label": "t:sections.main-list-collections.settings.sort.options__6.label" }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-list-collections.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label" }
      ],
      "default": "2",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label" }
      ],
      "default": "portrait",
      "label": "t:sections.main-list-collections.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "Heading alignment"
    },
    {
      "type": "select",
      "id": "heading_alignment_desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Desktop alignment"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Mobile alignment"
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Card text alignment"
    },
    {
      "type": "header",
      "content": "Load more"
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Collections to show",
      "info": "Number of collections visible before Load More. Each click reveals this same amount."
    },
    {
      "type": "text",
      "id": "load_more_label",
      "default": "Load More",
      "label": "Load more button text"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Desktop padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52,
      "label": "Desktop padding bottom"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28,
      "label": "Mobile padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Mobile padding bottom"
    }
  ]
}
{% endschema %}
