<style>
/* ---------- Section layout ---------- */
.community-reviews {
  position: relative;
}

.community-reviews__header {
  text-align: center;
  max-width: 60rem;
  margin: 0 auto 4rem;
}

.community-reviews__subheading {
    margin: 0 0 1rem;
    font-size: 12px;
    letter-spacing: 3px;
}

.community-reviews__heading {
  margin: 0 0 1.5rem;
}

.community-reviews__summary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.community-reviews__stars {
  display: inline-flex;
  align-items: center;
  gap: 0.2rem;
}

.community-reviews__star-icon {
  width: 1.6rem;
  height: auto;
}

.community-reviews__stars--muted .community-reviews__star-icon {
}

.community-reviews__score {
  font-weight: 700;
  font-size: 2.2rem;
  line-height: 1;
}

.community-reviews__count {
  color: rgba(var(--color-foreground), 0.75);
}

.community-reviews__body {
  position: relative;
}

/* ---------- Grid (3 or fewer reviews) ---------- */
.community-reviews__grid {
  display: grid;
  gap: 2.4rem;
  grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));
}

/* ---------- Slider (more than 3 reviews) ---------- */
.community-reviews__slider {
  overflow: hidden;
}

.community-reviews__slider .swiper-slide {
  height: auto;
}

.community-reviews__nav-button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 4.4rem;
  height: 4.4rem;
  padding: 0;
  border: 1px solid rgba(var(--color-foreground), 0.15);
  border-radius: 50%;
  background: rgb(var(--color-background));
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.community-reviews__nav-button svg {
  width: 1.8rem;
  height: 1.8rem;
}

.community-reviews__nav-button--prev {
  left: -1.5rem;
  transform: translateY(-50%) rotate(90deg);
}

.community-reviews__nav-button--next {
  right: -1.5rem;
  transform: translateY(-50%) rotate(-90deg);
}

.community-reviews__nav-button.swiper-button-disabled {
  opacity: 0.3;
  pointer-events: none;
}


.community-reviews__pagination .swiper-pagination-bullet {
  width: 0.9rem;
  height: 0.9rem;
  background: rgba(var(--color-foreground), 0.25);
  opacity: 1;
}

.community-reviews__pagination .swiper-pagination-bullet-active {
  background: rgb(var(--color-foreground));
}
.community-reviews__slider {
    padding-bottom: 57px ! important;
}

/* Independent arrow / dot visibility for desktop and mobile */
@media screen and (max-width: 749px) {
  .community-reviews--hide-nav-mobile .community-reviews__nav-button {
    display: none;
  }
  .community-reviews--hide-pagination-mobile .community-reviews__pagination {
    display: none;
  }
  .community-review-card {
    padding: 3rem 1.5rem 3rem !important;
    }
    .community-reviews__grid {
      gap:20px;
    }
    .community-reviews__header {
      margin: 0 auto 3rem;
    }
    .community-reviews__score {
      font-size: 18px;
    }
    {% comment %} .community-reviews__slider {
      padding-bottom: 100px !important;
    } {% endcomment %}
    .community-reviews__footer {
      margin-top: 2rem !important;
    }
    .community-review-card__image-wrapper {
      margin-bottom: 10px !important;
      padding-bottom: 10px !important;
  }
  .community-review-card{
    height: auto !important;
  }
}

@media screen and (min-width: 750px) {
  .community-reviews--hide-nav-desktop .community-reviews__nav-button {
    display: none;
  }
  .community-reviews--hide-pagination-desktop .community-reviews__pagination {
    display: none;
  }
}

.community-reviews__footer {
  text-align: center;
  margin-top: 4rem;
}
.community-reviews__footer a{
font-weight:600;
}

/* ---------- Review card ---------- */
.community-review-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
  border: 1px solid rgba(var(--color-foreground), 0.08);
  padding: 3rem 3rem 2.4rem;
}

.community-review-card__stars {
  display: inline-flex;
  gap: 0.2rem;
  margin-bottom: 1.6rem;
}

.community-review-card__star-icon {
  width: 1.4rem;
  height: auto;
}

.community-review-card__star-icon--empty {
  opacity: 0.2;
}

.community-review-card__text {
  margin: 0 0 2rem;
  line-height: 1.6;
}

.community-review-card__image-wrapper {
  margin-bottom: auto;
  padding-bottom: 2rem;
}

.community-review-card__image {
  display: block;
  width: 100%;
  height: 26rem;
  object-fit: cover;
}

.community-review-card__footer {
  padding-top: 2rem;
  border-top: 1px solid rgba(var(--color-foreground), 0.1);
}

.community-review-card__name {
    margin: 0 0 0.2rem;
    font-weight: 600;
    font-size: 13px;
}

.community-review-card__detail {
  margin: 0;
  color: rgba(var(--color-foreground), 0.6);
  font-size: 12px;
}

</style>

{%- liquid
  assign use_slider = true
-%}

{%- if use_slider -%}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{%- endif -%}

<div
  class="community-reviews color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.hide_nav_mobile %} community-reviews--hide-nav-mobile{% endif %}{% if section.settings.hide_nav_desktop %} community-reviews--hide-nav-desktop{% endif %}{% if section.settings.hide_pagination_mobile %} community-reviews--hide-pagination-mobile{% endif %}{% if section.settings.hide_pagination_desktop %} community-reviews--hide-pagination-desktop{% endif %}"
>
  <div class="page-width">

    <div class="community-reviews__header">
      {%- if section.settings.subheading != blank -%}
        <p class="community-reviews__subheading caption-with-letter-spacing">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="community-reviews__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_rating_summary -%}
        <div class="community-reviews__summary">
          {%- if section.settings.star_icon != blank -%}
            <span class="community-reviews__stars community-reviews__stars--muted">
              {%- for i in (1..5) -%}
                {{ section.settings.star_icon | image_url: width: 32 | image_tag: class: 'community-reviews__star-icon', loading: 'lazy', alt: '' }}
              {%- endfor -%}
            </span>
          {%- endif -%}
          {%- if section.settings.rating_score != blank -%}
            <span class="community-reviews__score">{{ section.settings.rating_score }}</span>
          {%- endif -%}
          {%- if section.settings.review_count_text != blank -%}
            <span class="community-reviews__count">&nbsp;&middot; {{ section.settings.review_count_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="community-reviews__body">
      {%- if use_slider -%}
        <div class="swiper community-reviews__slider" id="CommunityReviews-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {%- render 'community-review-card', block: block -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if section.settings.enable_pagination_desktop or section.settings.enable_pagination_mobile -%}
            <div class="swiper-pagination community-reviews__pagination"></div>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_navigation_desktop or section.settings.enable_navigation_mobile -%}
          <button type="button" class="community-reviews__nav-button community-reviews__nav-button--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
            <svg class="icon icon-caret" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"/></svg>

          </button>
          <button type="button" class="community-reviews__nav-button community-reviews__nav-button--next" aria-label="{{ 'general.slider.next_slide' | t }}">
            <svg class="icon icon-caret" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"/></svg>

          </button>
        {%- endif -%}

      {%- else -%}
        <div class="community-reviews__grid community-reviews__grid--{{ section.blocks.size }}">
          {%- for block in section.blocks -%}
            <div class="community-reviews__grid-item" {{ block.shopify_attributes }}>
              {%- render 'community-review-card', block: block -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <div class="community-reviews__footer">
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="community-reviews__button link underlined-link caption-with-letter-spacing"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

{%- if use_slider -%}
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var slidesPerViewDesktop = {{ section.settings.slides_per_view_desktop | default: 3 }};
      var slidesPerViewMobile = {{ section.settings.slides_per_view_mobile | default: 1 }};
      var autoplayEnabled = {{ section.settings.enable_autoplay | json }};
      var autoplayDelay = {{ section.settings.autoplay_speed | default: 5 }} * 1000;

      function initCommunityReviewsSlider() {
        var container = document.getElementById('CommunityReviews-' + sectionId);
        if (!container || typeof Swiper === 'undefined') return;
        if (container.swiper) container.swiper.destroy(true, true);

        var wrapper = container.closest('.community-reviews');
        var nextEl = wrapper.querySelector('.community-reviews__nav-button--next');
        var prevEl = wrapper.querySelector('.community-reviews__nav-button--prev');
        var paginationEl = wrapper.querySelector('.community-reviews__pagination');

        new Swiper(container, {
          slidesPerView: slidesPerViewMobile,
          spaceBetween: 20,
          watchOverflow: true,
          autoplay: autoplayEnabled ? { delay: autoplayDelay, disableOnInteraction: false } : false,
          navigation: (nextEl && prevEl) ? { nextEl: nextEl, prevEl: prevEl } : false,
          pagination: paginationEl ? { el: paginationEl, clickable: true } : false,
          breakpoints: {
            750: {
              slidesPerView: slidesPerViewDesktop,
              spaceBetween: 32
            }
          }
        });
      }

      if (typeof Swiper === 'undefined') {
        window.addEventListener('load', initCommunityReviewsSlider);
      } else {
        document.addEventListener('DOMContentLoaded', initCommunityReviewsSlider);
      }
      document.addEventListener('shopify:section:load', initCommunityReviewsSlider);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Community reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real women, real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What the Community Says"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h2", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__5.label" },
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "checkbox",
      "id": "show_rating_summary",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "star_icon",
      "label": "Star icon"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "2,847 verified reviews"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "paragraph",
      "content": "Automatically becomes a slider when there are more than 3 reviews."
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides per view (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides per view (mobile)",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "enable_navigation_desktop",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_navigation_mobile",
      "label": "Show arrows on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_nav_desktop",
      "label": "Hide arrows on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_nav_mobile",
      "label": "Hide arrows on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_pagination_desktop",
      "label": "Show dots on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_pagination_mobile",
      "label": "Show dots on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_pagination_desktop",
      "label": "Hide dots on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_pagination_mobile",
      "label": "Hide dots on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read all 2,847 reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (stars)",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "The cut-out dress is EVERYTHING. Felt like a goddess at my sister's birthday. Already ordered 2 more colors. True to size, ships fast."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Aaliyah M."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Customer detail",
          "default": "Wearing size 3X"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Community reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
