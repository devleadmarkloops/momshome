<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="bp-instagram color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="bp-instagram__wrapper{% unless section.settings.full_width %} page-width{% endunless %}">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="bp-instagram__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="bp-instagram__heading {{ section.settings.heading_size }}">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="bp-instagram__heading-link">{{ section.settings.heading | escape }}</a>
            {%- else -%}
              {{ section.settings.heading | escape }}
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bp-instagram__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bp-instagram__slider-wrapper">
        <div class="swiper bp-instagram__slider" id="BpInstagramSlider-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- liquid
                assign link_url = block.settings.link
                if link_url == blank and section.settings.instagram_url != blank
                  assign link_url = section.settings.instagram_url
                endif
              -%}
              <div class="swiper-slide bp-instagram__slide" {{ block.shopify_attributes }}>
                {%- if link_url != blank -%}
                  <a href="{{ link_url }}" target="_blank" rel="noopener" class="bp-instagram__slide-link" aria-label="{{ section.settings.heading | default: 'Instagram' | escape }}">
                {%- else -%}
                  <div class="bp-instagram__slide-link">
                {%- endif -%}

                  <div class="bp-instagram__media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image
                        | image_url: width: 1000
                        | image_tag:
                          class: 'bp-instagram__image',
                          widths: '360, 480, 640, 800, 1000',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw',
                          loading: 'lazy'
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'bp-instagram__image bp-instagram__image--placeholder' }}
                    {%- endif -%}

                    {%- if section.settings.show_icon -%}
                      <span class="bp-instagram__icon-badge{% if block.settings.always_show_icon %} bp-instagram__icon-badge--always{% endif %}" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22">
                          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
                          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
                          <circle cx="17.2" cy="6.8" r="1.3" fill="currentColor"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </div>

                {%- if link_url != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_arrows -%}
          <button type="button" class="bp-instagram__nav bp-instagram__nav--prev" id="BpInstagramPrev-{{ section.id }}" aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous' }}">
            <svg viewBox="0 0 24 24" fill="none" width="18" height="18"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="bp-instagram__nav bp-instagram__nav--next" id="BpInstagramNext-{{ section.id }}" aria-label="{{ 'general.slider.next_slide' | t | default: 'Next' }}">
            <svg viewBox="0 0 24 24" fill="none" width="18" height="18"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_dots -%}
          <div class="bp-instagram__pagination swiper-pagination" id="BpInstagramDots-{{ section.id }}"></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .bp-instagram__wrapper {
    position: relative;
  }

  .bp-instagram__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .bp-instagram__heading {
    margin: 0;
  }

  .bp-instagram__heading-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  .bp-instagram__heading-link:hover {
    opacity: 0.7;
  }

  .bp-instagram__subheading {
    margin: 0.6rem 0 0;
    font-size: 1.3rem;
    letter-spacing: 0.06em;
  }

  .bp-instagram__slider-wrapper {
    position: relative;
  }

  .bp-instagram__slide-link {
    display: block;
    text-decoration: none;
  }

  .bp-instagram__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_ratio }};
    background: rgba(var(--color-foreground), 0.04);
  }

  .bp-instagram__image,
  .bp-instagram__media img,
  .bp-instagram__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bp-instagram__slide-link:hover .bp-instagram__image {
    transform: scale(1.06);
  }

  .bp-instagram__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .bp-instagram__slide-link:hover .bp-instagram__media::after {
    opacity: 1;
  }

  .bp-instagram__icon-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.85);
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 1.1rem;
    background: #ffffff;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.35s ease;
    z-index: 2;
    pointer-events: none;
  }

  .bp-instagram__slide-link:hover .bp-instagram__icon-badge,
  .bp-instagram__icon-badge--always {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .bp-instagram__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s ease, opacity 0.25s ease;
    opacity: 0.95;
  }

  .bp-instagram__nav:hover {
    transform: translateY(-50%) scale(1.08);
  }

  .bp-instagram__nav--prev { left: 0.8rem; }
  .bp-instagram__nav--next { right: 0.8rem; }

  .bp-instagram__nav.swiper-button-disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .bp-instagram__pagination {
    position: static;
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .bp-instagram__pagination .swiper-pagination-bullet {
    width: 0.8rem;
    height: 0.8rem;
    background: rgb(var(--color-foreground));
    opacity: 0.25;
    transition: opacity 0.25s ease, width 0.25s ease;
    border-radius: 1rem;
    margin: 0 !important;
  }

  .bp-instagram__pagination .swiper-pagination-bullet-active {
    opacity: 1;
    width: 2.2rem;
  }

  @media screen and (max-width: 749px) {
    .bp-instagram__header {
      margin-bottom: 2rem;
    }

    .bp-instagram__nav {
      width: 3.4rem;
      height: 3.4rem;
    }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  (function () {
    var sectionId = '{{ section.id }}';

    function initBpInstagramSlider() {
      var el = document.getElementById('BpInstagramSlider-' + sectionId);
      if (!el || typeof Swiper === 'undefined') return;

      if (el.swiper) el.swiper.destroy(true, true);

      new Swiper(el, {
        slidesPerView: {{ section.settings.slides_mobile }},
        spaceBetween: {{ section.settings.spacing_mobile }},
        loop: {% if section.settings.enable_loop %}true{% else %}false{% endif %},
        speed: 700,
        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        {% endif %}
        {% if section.settings.show_arrows %}
        navigation: {
          nextEl: '#BpInstagramNext-' + sectionId,
          prevEl: '#BpInstagramPrev-' + sectionId
        },
        {% endif %}
        {% if section.settings.show_dots %}
        pagination: {
          el: '#BpInstagramDots-' + sectionId,
          clickable: true
        },
        {% endif %}
        breakpoints: {
          750: {
            slidesPerView: {{ section.settings.slides_tablet }},
            spaceBetween: {{ section.settings.spacing_desktop }}
          },
          990: {
            slidesPerView: {{ section.settings.slides_desktop }},
            spaceBetween: {{ section.settings.spacing_desktop }}
          }
        }
      });
    }

    function waitForSwiper() {
      if (typeof Swiper !== 'undefined') {
        initBpInstagramSlider();
      } else {
        setTimeout(waitForSwiper, 100);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForSwiper);
    } else {
      waitForSwiper();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) waitForSwiper();
    });
  })();
</script>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us On Instagram"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "#Bodypolitix"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL",
      "info": "Used as fallback link for heading and all slides."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Instagram icon on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides on desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Slides on tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides on mobile",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "spacing_desktop",
      "label": "Space between slides (desktop)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "label": "Space between slides (mobile)",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay delay",
      "min": 2,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — link to specific post. Leave blank to use profile URL."
        },
        {
          "type": "checkbox",
          "id": "always_show_icon",
          "label": "Always show Instagram icon on this slide",
          "default": false,
          "info": "Like the center slide in the reference design."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
